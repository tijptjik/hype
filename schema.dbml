table account {
  id text [pk, not null]
  userId text [not null]
  accountId text [not null]
  issuer text
  providerId text [not null]
  accessToken text
  refreshToken text
  accessTokenExpiresAt integer
  refreshTokenExpiresAt integer
  scope text
  idToken text
  password text
  createdAt integer [not null]
  updatedAt integer [not null]

  indexes {
    (providerId, accountId) [name: 'account_providerId_accountId_uidx', unique]
  }
}

table address {
  id text [pk, not null]
  sourceKey text [not null]
}

table addressRevision {
  id text [pk, not null]
  addressId text [not null]
  scope text [not null]
  components text [not null]
  geometry text
  sourceVersion text
  contentHash text [not null]
  sourceReferences text [not null]
  rawSource text [not null]
  createdAt text [not null, default: `(strftime('%Y-%m-%dT%H:%M:%fZ','now'))`]

  indexes {
    (addressId, contentHash) [name: 'address_revision_content', unique]
  }
}

table breadlineImportIdentity {
  active integer [not null, default: 1]
  sourceUserId integer [pk, not null]
  sourceVolunteerId integer
  userId text [not null]
  email text
  name text
  sourceUid text
}

table breadlineImportUser {
  userId text [pk, not null]
  telephone text [unique]
  state text [not null]
  claimedEmail text
  claimedAt integer
  claimKey text
}

table cardStyle {
  code text [pk, not null]
}

table divisionDefinition {
  id text [pk, not null]
  apiReleaseSet text [not null]
  attributes text [not null]
}

table divisionI18n {
  divisionId text [not null]
  locale text [not null]
  name text
  namedValues text [not null]

  indexes {
    (divisionId, locale) [pk]
    (locale, name, divisionId) [name: 'division_i18n_name']
  }
}

table divisionRefresh {
  id integer [pk, not null]
  appliedRelease text
  targetRelease text
  targetReleaseId text
  comparisonId text
  cursor text
  phase text [not null, default: 'idle']
  checkedMonth text
  lease text
  leaseUntil integer [not null, default: 0]
  lastError text
}

table divisionRefreshChange {
  id text [pk, not null]
  payload text [not null]
  featureCursor text [not null, default: '']
}

table facebookDeletionRequest {
  confirmationCodeHash text [pk, not null]
  completedAt integer [not null]
}

table feature {
  localLocationBrands text
  id text [pk, not null]
  organisationId text [not null]
  projectId text [not null]
  layerId text [not null]
  contributorId text
  geometry text [not null]
  spatialIndex text
  countryId text
  areaId text
  districtId text
  townId text
  ruralAreaId text
  macrohoodId text
  neighbourhoodId text
  villageId text
  microhoodId text
  hamletId text
  islandId text
  divisionResolution text
  mtrStation text
  mtrExit text
  mtrDistance integer
  mtrResolution text
  addressMeta text [default: `{}`]
  isPublished integer [not null, default: 0]
  localIsPublished integer
  publisherId text
  publishedAt text
  isPendingReview integer [not null, default: 0]
  isArchived integer [not null, default: 0]
  isDraft integer [not null, default: 0]
  localIsArchived integer
  isIntangible integer [not null, default: 0]
  isVisitable integer [not null, default: 1]
  visitableAsOf text [default: `(CURRENT_DATE)`]
  formWriteToken text
  createdAt text [not null, default: `(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))`]
  modifiedAt text [not null, default: `(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))`]

  indexes {
    (countryId, id) [name: 'feature_countryId']
    (areaId, id) [name: 'feature_areaId']
    (districtId, id) [name: 'feature_districtId']
    (townId, id) [name: 'feature_townId']
    (ruralAreaId, id) [name: 'feature_ruralAreaId']
    (macrohoodId, id) [name: 'feature_macrohoodId']
    (neighbourhoodId, id) [name: 'feature_neighbourhoodId']
    (villageId, id) [name: 'feature_villageId']
    (microhoodId, id) [name: 'feature_microhoodId']
    (hamletId, id) [name: 'feature_hamletId']
    (islandId, id) [name: 'feature_islandId']
    (isDraft, isPublished, isArchived, layerId, organisationId, projectId, id, isVisitable, isIntangible) [name: 'feature_query_visibility_idx']
    (layerId, isDraft, isPublished, isArchived, id, organisationId, projectId, isVisitable, isIntangible) [name: 'feature_query_layer_idx']
    (id, isDraft, isPublished, isArchived, layerId, organisationId, projectId, isVisitable, isIntangible) [name: 'feature_query_id_idx']
  }
}

table featureCountCache {
  key text [pk, not null]
  revision integer [not null]
  userRevision integer [not null, default: 0]
  totalCount integer [not null]
  facets text [not null]
  updatedAt integer [not null]

  indexes {
    (updatedAt, key) [name: 'feature_count_cache_updated_idx']
  }
}

table featureCountEntry {
  featureId text [pk, not null]
  organisationId text [not null]
  projectId text [not null]
  layerId text [not null]
  isPublished integer [not null]
  isArchived integer [not null]
  isDraft integer [not null]
  isVisitable integer [not null]
  isIntangible integer [not null]
  countryId text [not null]
  areaId text [not null]
  districtId text [not null]
  townId text [not null]
  ruralAreaId text [not null]
  macrohoodId text [not null]
  neighbourhoodId text [not null]
  villageId text [not null]
  microhoodId text [not null]
  hamletId text [not null]
  islandId text [not null]
}

table featureCountRevision {
  id integer [pk, not null]
  revision integer [not null, default: 0]
}

table featureCountRollup {
  organisationId text [not null]
  projectId text [not null]
  layerId text [not null]
  isPublished integer [not null]
  isArchived integer [not null]
  isDraft integer [not null]
  isVisitable integer [not null]
  isIntangible integer [not null]
  countryId text [not null]
  areaId text [not null]
  districtId text [not null]
  townId text [not null]
  ruralAreaId text [not null]
  macrohoodId text [not null]
  neighbourhoodId text [not null]
  villageId text [not null]
  microhoodId text [not null]
  hamletId text [not null]
  islandId text [not null]
  totalCount integer [not null]

  indexes {
    (organisationId, projectId, layerId, isPublished, isArchived, isDraft, isVisitable, isIntangible, countryId, areaId, districtId, townId, ruralAreaId, macrohoodId, neighbourhoodId, villageId, microhoodId, hamletId, islandId) [pk]
    (layerId, isDraft, isPublished, isArchived) [name: 'feature_count_rollup_layer_idx']
    (isDraft, isPublished, isArchived, layerId) [name: 'feature_count_rollup_visibility_idx']
  }
}

table featureCountUserRevision {
  userId text [pk, not null]
  revision integer [not null, default: 0]
}

table featureDivisionJob {
  featureId text [pk, not null]
  generation integer [not null, default: 1]
  attempts integer [not null, default: 0]
  retryAt integer [not null, default: 0]
  lastError text

  indexes {
    (retryAt, featureId) [name: 'feature_division_job_retry']
  }
}

table featureDivisionMembership {
  featureId text [not null]
  divisionId text [not null]
  selected integer [not null]

  indexes {
    (featureId, divisionId) [pk]
    (divisionId, featureId) [name: 'feature_division_membership_division']
  }
}

table featureI18n {
  featureId text [not null]
  locale text [not null]
  title text [not null]
  titleGen integer [not null, default: 1]
