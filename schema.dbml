    (featureId, imageId) [pk]
    featureId [name: 'canonical_intent', unique]
  }
}

table featureLocation {
  featureId text [pk, not null]
  locationId text [not null]
  version text [not null, default: 'initial']
  actorId text
  factsRevisionId text [not null]
  locationRevisionId text [not null]
  acceptedOverrides text [not null, default: `{}`]
  factsOrganisationRevision text
  locationOrganisationRevision text
