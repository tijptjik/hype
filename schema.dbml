  indexes {
    
    (locationId, featureId) [name: 'feature_location_location']
    
    
  }
}

table featureLocationHistory {
  id integer [pk, not null, increment]
  featureId text [not null]
  version text [not null]
  previousRevision text
  action text [not null]
  locationId text [not null]
  factsRevisionId text [not null]
  locationRevisionId text [not null]
  acceptedOverrides text [not null]
  actorId text
  factsOrganisationRevision text
  locationOrganisationRevision text
  occupancyRevisionId text
  addressRevisionId text
  membershipRevisionIds text [not null, default: `[]`]
  placementOverrides text [not null, default: `{}`]
  geometry text
  policySnapshot text
  adoptionProposalId text
  createdAt text [not null, default: `(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))`]

  indexes {
    (featureId, id) [name: 'feature_location_history_feature']
    (featureId, version) [name: 'feature_location_history_revision', unique]
    
    
  }
}

