{
  "version": 8,
  "name": "Hyper Dark",
  "metadata": {
    "hype:style-variant": "Etch",
    "hype:theme": "hype-black"
  },
  "sources": {
    "building-labels": {
      "type": "geojson",
      "data": "/mapData/building-labels.geojson",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">© OpenStreetMap contributors</a>"
    },
    "hongkong-latest": {
      "type": "vector",
      "url": "https://tiles.saanseoi.hk/hongkong-latest.json"
    }
  },
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "hongkong-latest",
      "source-layer": "earth",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#08070d"
      }
    },
    {
      "id": "gardens",
      "type": "fill",
      "source": "hongkong-latest",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "forest",
            "wood",
            "nature_reserve",
            "national_park",
            "garden",
            "golf_course"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#101a18",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hongkong-latest",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#000000"
      }
    },
    {
      "id": "coast",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "coastline"
      ],
      "paint": {
        "line-color": "#76d9ad",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.15,
          14,
          0.6,
          18,
          1,
          21,
          3
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "footprints",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "line-color": "#7253ae",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.45,
          16,
          0.65,
          18,
          1,
          20,
          1.5,
          22,
          2
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.55,
          17,
          0.8,
          20,
          0.95
        ]
      }
    },
    {
      "id": "route-other",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "other"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "minzoom": 16,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3e365b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.05,
          14,
          0.2,
          18,
          1,
          21,
          3
        ],
        "line-opacity": 0.4,
        "line-blur": 0
      }
    },
    {
      "id": "route-minor_road",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "minor_road"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "minzoom": 13,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3e365b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.1,
          14,
          0.4,
          18,
          1.2,
          21,
          3.5999999999999996
        ],
        "line-opacity": 1,
        "line-blur": 0
      }
    },
    {
      "id": "route-major_road",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "major_road"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "minzoom": 7,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f04d7f",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.25,
          14,
          1,
          18,
          2.2,
          21,
          6.6000000000000005
        ],
        "line-opacity": 1,
        "line-blur": 0
      }
    },
    {
      "id": "route-highway",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "highway"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "minzoom": 7,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f6b3cf",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.375,
          14,
          1.5,
          18,
          3.2,
          21,
          9.600000000000001
        ],
        "line-opacity": 1,
        "line-blur": 0
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#76d9ad",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.125,
          14,
          0.5,
          18,
          1.6,
          21,
          4.800000000000001
        ],
        "line-dasharray": [
          1,
          4
        ],
        "line-opacity": 0.5
      }
    },
    {
      "id": "districts",
      "type": "symbol",
      "source": "hongkong-latest",
      "source-layer": "places",
      "minzoom": 9,
      "maxzoom": 16,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "locality",
            "neighbourhood",
            "macrohood"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name2"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          13,
          15,
          16
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.18,
        "text-max-width": 8,
        "text-padding": 25
      },
      "paint": {
        "text-color": "#e6d3ff",
        "text-halo-color": "#08070d",
        "text-halo-width": 0.7,
        "text-halo-blur": 0
      }
    },
    {
      "id": "streets",
      "type": "symbol",
      "source": "hongkong-latest",
      "source-layer": "roads",
      "minzoom": 16,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "major_road",
            "minor_road"
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 900,
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name2"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          16,
          11.5,
          19,
          13
        ],
        "text-letter-spacing": 0.08,
        "text-max-angle": 25,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#f7e7ef",
        "text-halo-color": "#08070d",
        "text-halo-width": 1.4,
        "text-halo-blur": 0
      }
    },
    {
      "id": "building-names",
      "type": "symbol",
      "source": "building-labels",
      "minzoom": 18,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "building",
            "mall"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          18,
          11,
          20,
          12.5
        ],
        "text-max-width": 9,
        "text-padding": 4,
        "text-variable-anchor": [
          "center",
          "top",
          "bottom"
        ],
        "text-radial-offset": 0.4,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#c6b6d9",
        "text-halo-color": "#08070d",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "building-numbers",
      "type": "symbol",
      "source": "hongkong-latest",
      "source-layer": "buildings",
      "minzoom": 19,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "address"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "addr_housenumber"
          ],
          [
            "get",
            "addr:housenumber"
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 12,
        "text-padding": 3,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#f7e7ef",
        "text-halo-color": "#08070d",
        "text-halo-width": 1.2
      }
    }
  ],
  "sprite": "https://protomaps.github.io/basemaps-assets/sprites/v4/dark"
}
