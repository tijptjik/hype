{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hype Recorder",
  "identifier": "hk.hype.recorder",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "frontendDist": "../build",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [{ "title": "Hype Recorder", "width": 420, "height": 800 }],
    "security": {
      "capabilities": ["recorder"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "icon": ["icons/icon.png"] }
}
