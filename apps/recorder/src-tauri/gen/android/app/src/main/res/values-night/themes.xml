<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.hype_recorder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Use the HYPE mark on the same canvas throughout Android's launch transition. -->
        <item name="android:windowBackground">#08090E</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#08090E</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/recorder_splash</item>
    </style>
</resources>
