{
  "name": "@hype/recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "dev-server vite dev --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "android:fi": "HYPE_RECORDER_FI=1 tauri android build --debug --apk --target aarch64 --config src-tauri/fi.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
