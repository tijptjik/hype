[Unit]
Description=Fetch, compare and publish changed Hype indoor maps
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/code/hype
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
Environment=HYPE_INDOOR_TARGET=local
ExecStart=%h/.local/bin/dev-check /usr/bin/bash scripts/dataops/run.sh indoor:monthly --target ${HYPE_INDOOR_TARGET}
TimeoutStartSec=6h
Nice=10
Restart=on-failure
RestartSec=1h
