    "sharp": "^0.35.5",
    "smartcrop": "^2.0.5",
    "substack-subscriber": "^1.0.0",
    "svelte-auto-animate": "^0.0.1",
    "svelte-dnd-action": "^0.9.80",
    "svelte-fa": "^4.0.4",
    "svelte-file-dropzone": "^2.0.9",
    "svelte-gestures": "^5.2.2",
    "svelte-maplibre-gl": "2.2.1",
    "svelte-portal": "^2.2.1",
    "svelte-range-slider-pips": "^4.1.1",
    "svelte-sonner": "^1.2.3",
    "svelte-toolbelt": "0.10.6",
    "tailwind-merge": "^3.7.0",
    "unique-names-generator": "^4.7.1",
    "uqr": "0.1.3",
    "utif": "^3.1.0",
    "uuid": "14.0.3",
