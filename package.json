  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint",
      "config": {
        "path": ".cz-config.js"
      }
    }
  },
  "license": "FSL-1.1-MIT",
  "patchedDependencies": {
    "@sveltejs/kit@3.1.1": "patches/@sveltejs%2Fkit@3.1.1.patch",
    "@milkdown/components@7.23.0": "patches/@milkdown%2Fcomponents@7.23.0.patch"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "workspaces": [
    "workers/*",
    "packages/*"
  ]
}
