{
  "name": "hype",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "issues": {
    "url": "https://github.com/tijptjik/hype/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:messaging-notifications": "wrangler dev --config workers/messaging-notifications/wrangler.jsonc --local --ip 127.0.0.1 --port 8796 --persist-to .wrangler/state",
    "dev:agent": "bun run scripts/dev/agent.ts",
    "dev:cf:preview": "CLOUDFLARE_ENV=preview vite dev",
    "dev:cf:prod": "CLOUDFLARE_ENV=production vite dev",
    "dev:local": "HYPE_LOCAL_R2=1 vite dev",
    "dev:no-mullvad": "mullvad-exclude vite dev",
    "dev:asset-service:local": "bun wrangler dev -c workers/asset-service/wrangler.toml --persist-to .wrangler/state/asset-service --port 8790",
    "dev:asset-service:simulated": "bun wrangler dev -c workers/asset-service/wrangler.local.toml --local --persist-to .wrangler/state/asset-service --port 8790",
    "dev:asset-service:remote": "bun wrangler dev -c workers/asset-service/wrangler.toml --remote --port 8790",
    "dev:asset-service:remote:preview": "bun wrangler dev -c workers/asset-service/wrangler.toml --remote --env preview --port 8790",
    "dev:asset-service:remote:prod": "bun wrangler dev -c workers/asset-service/wrangler.toml --remote --env production --port 8790",
    "dev:queue:prod": "sh -c 'bun run dev:cf:prod & wait'",
    "build": "bun run i18n:build && sync && vite build",
    "build:preview": "vite preview",
    "build:cf:prod": "CLOUDFLARE_ENV=production bun run build --mode production",
    "build:cf:preview": "CLOUDFLARE_ENV=preview bun run build --mode preview",
    "db:dump:local": "TIMESTAMP=$(date +'%Y-%m-%dT%H:%M:%S') && OUTPUT_FILE=sql/backup/hype-db-local-${TIMESTAMP}.sql && DB_FILE=$(ls -t .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite 2>/dev/null | grep -v 'metadata.sqlite' | head -1) && sqlite3 \"$DB_FILE\" '.dump' > ${OUTPUT_FILE} && echo \"✅ Exported to ${OUTPUT_FILE}\" && sql/processing/sql_dump_to_ordered_backup.sh ${OUTPUT_FILE} sql/backup/hype-db-local-${TIMESTAMP}-ordered.sql && echo \"✅ Reordered to sql/backup/hype-db-local-${TIMESTAMP}-ordered.sql\"",
    "db:dump:cf:preview": "bun run scripts/dev/export-d1.ts preview",
    "db:dump:cf:prod": "bun run scripts/dev/export-d1.ts prod",
    "db:prepare:local": "bun run db:rebuild:local --apply",
    "db:rebuild:local": "bun --env-file=.dev.vars run scripts/dev/rebuild.ts",
    "breadline:db:inspect": "bun --env-file=.dev.vars run scripts/breadline/inspect-source.ts",
    "breadline:db:sync": "bun --env-file=.dev.vars run scripts/breadline/sync-source.ts",
    "breadline:db:status": "bun run scripts/breadline/status.ts",
    "breadline:db:test": "bun test scripts/breadline",
    "db:reset:local": "bunx wrangler d1 execute hype-db-local --file=sql/routines/reset_db.sql && echo \"✅ Local database reset complete\"",
    "db:reset:preview": "bunx wrangler d1 execute hype-db-preview --remote --file=sql/routines/reset_db.sql && echo \"✅ Preview database reset complete\"",
    "db:restore:latest:prod": "LATEST_FILE=$(ls -t sql/backup/hype-db-prod-*-ordered.sql 2>/dev/null | head -1) && if [ -n \"$LATEST_FILE\" ]; then sql/processing/restore_local_backup.sh \"$LATEST_FILE\"; else echo \"❌ No ordered prod backup files found\"; fi",
    "db:restore:latest:prod:to:preview": "LATEST_FILE=$(ls -t sql/backup/hype-db-prod-*-ordered.sql 2>/dev/null | head -1) && if [ -n \"$LATEST_FILE\" ]; then bunx wrangler d1 execute hype-db-preview --remote --file=\"$LATEST_FILE\" && echo \"✅ Restored from $LATEST_FILE\"; else echo \"❌ No ordered prod backup files found\"; fi",
    "db:restore:latest:local:to:preview": "LATEST_FILE=$(ls -t sql/backup/hype-db-local-*-ordered.sql 2>/dev/null | head -1) && if [ -n \"$LATEST_FILE\" ]; then bunx wrangler d1 execute hype-db-preview --remote --file=\"$LATEST_FILE\" && echo \"✅ Restored from $LATEST_FILE\"; else echo \"❌ No ordered local backup files found\"; fi",
    "db:restore:latest:preview": "LATEST_FILE=$(ls -t sql/backup/hype-db-preview-*-ordered.sql 2>/dev/null | head -1) && if [ -n \"$LATEST_FILE\" ]; then sql/processing/restore_local_backup.sh \"$LATEST_FILE\"; else echo \"❌ No ordered preview backup files found\"; fi",
    "db:seed:eln-test-tasks:local": "bunx wrangler d1 execute hype-db-local --file=sql/routines/reset_eln_test_tasks.sql && echo \"✅ ELN test tasks reset complete\"",
    "db:migration:new": "drizzle-kit generate --name",
    "db:migration:new:empty": "drizzle-kit generate --custom --name",
    "db:migration:run:local": "bunx wrangler d1 migrations apply hype-db-local",
    "db:migration:run:cf:prod": "bunx wrangler d1 migrations apply hype-db-prod --remote --env production",
    "db:migration:run:cf:preview": "bunx wrangler d1 migrations apply hype-db-preview --remote --env preview",
    "db:sync:map:styles:local": "bun run scripts/sync-map-styles.ts local",
    "db:sync:map:styles:preview": "bun run scripts/sync-map-styles.ts preview",
    "db:sync:map:styles:prod": "bun run scripts/sync-map-styles.ts prod",
    "db:mirror:prod:to:local": "bun run db:prepare:local",
    "db:mirror:post:local": "bun run db:migration:run:local && bun run db:sync:map:styles:local && bun --env-file=.dev.vars run scripts/dev/prepare-mirror.ts",
    "db:mirror:local:to:preview": "bun run db:dump:local && bun run db:reset:preview && bun run db:restore:latest:local:to:preview",
    "db:mirror:prod:to:preview": "bun run db:dump:cf:prod && bun run db:reset:preview && bun run db:restore:latest:prod:to:preview",
    "db:studio:local": "drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:cf:prod": "NODE_ENV=production bun --env-file=.env.drizzle.prod.local drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:cf:preview": "NODE_ENV=production bun --env-file=.env.drizzle.preview.local drizzle-kit studio --config=drizzle.config.ts",
    "routing:configure:local": "python3 scripts/routing/use-shared-service.py local",
    "routing:configure:prod": "python3 scripts/routing/use-shared-service.py production",
    "routing:configure:preview": "python3 scripts/routing/use-shared-service.py preview",
    "deploy:prod": "bun --env-file=.dev.vars run scripts/revisions/rollout.ts production --apply",
    "deploy:preview": "bun --env-file=.dev.vars run scripts/revisions/rollout.ts preview --apply",
    "revisions:prepare:prod": "bun --env-file=.dev.vars run scripts/revisions/rollout.ts production",
    "revisions:prepare:preview": "bun --env-file=.dev.vars run scripts/revisions/rollout.ts preview",
    "deploy:asset-service:prod": "bun wrangler deploy -c workers/asset-service/wrangler.toml --env production",
    "deploy:asset-service:preview": "bun wrangler deploy -c workers/asset-service/wrangler.toml --env preview",
    "deploy:asset-memory-repair:prod": "bun wrangler deploy -c workers/asset-memory-repair/wrangler.toml --env production",
    "deploy:division-refresh:prod": "bun wrangler deploy -c workers/division-refresh/wrangler.jsonc --env production",
    "deploy:division-refresh:preview": "bun wrangler deploy -c workers/division-refresh/wrangler.jsonc --env preview",
    "deploy:maintenance-scheduler:prod": "bun wrangler deploy -c workers/maintenance-scheduler/wrangler.toml --env production",
    "deploy:maintenance-scheduler:preview": "bun wrangler deploy -c workers/maintenance-scheduler/wrangler.toml --env preview",
    "deploy:render-service:prod": "bun wrangler deploy -c workers/map-render-service/wrangler.toml --env production",
    "deploy:render-service:preview": "bun wrangler deploy -c workers/map-render-service/wrangler.toml --env preview",
    "check:division-refresh": "tsc -p workers/division-refresh/tsconfig.json",
    "auth:secrets:configure": "bun run scripts/cloud/configure-auth-secrets.ts",
    "render:assets": "bun run scripts/generate-image-derived-assets.ts",
    "feature:divisions:prepare:remote": "node --import tsx scripts/cloud/prepare-divisions.ts",
    "feature:divisions:backfill": "bun run scripts/backfill-feature-divisions.ts",
    "feature:spatial:backfill": "bun run scripts/backfill-feature-spatial-index.ts",
    "image:hash:backfill": "bun run scripts/backfill-image-content-hashes.ts",
    "image:hash:backfill:prod": "bun run scripts/backfill-image-content-hashes.ts --remote --stage production",
    "images:test:fixtures": "bun run scripts/generate-upload-test-images.ts",
    "stage:asset-worker:fixtures": "bun run scripts/cloud/stage-asset-worker-probe-fixtures.ts",
    "test:asset-worker:memory": "bun run scripts/cloud/probe-asset-worker-memory.ts",
    "r2:normalize:raw": "bun run scripts/cloud/normalize-r2-raw-images.ts",
    "r2:resize:raw": "bun run scripts/cloud/normalize-r2-raw-images.ts --mode apply",
    "r2:sync:object": "bun run scripts/cloud/sync-r2-object-local.ts",
    "render:map": "bun run scripts/generate-map-renders.ts",
    "render:map:styles": "bun run i18n:build && bun run scripts/generate-map-style-renders.ts",
    "render:map:layers": "bun run scripts/generate-map-renders.ts layers",
    "render:map:projects": "bun run scripts/generate-map-renders.ts projects",
    "render:map:init": "bun run scripts/generate-map-renders.ts --force",
    "render:map:styles:init": "bun run i18n:build && bun run scripts/generate-map-style-renders.ts --force",
    "render:map:layers:init": "bun run scripts/generate-map-renders.ts layers --force",
    "render:map:projects:init": "bun run scripts/generate-map-renders.ts projects --force",
    "check": "bash scripts/dev-check.sh bash -c 'svelte-kit sync && svelte-check --tsconfig ./tsconfig.json \"$@\"' --",
    "check:watch": "bash scripts/dev-check.sh bash -c 'svelte-check --tsconfig ./tsconfig.json --watch \"$@\"' --",
    "cs:add": "node ./node_modules/@changesets/cli/bin.js",
    "cs:version": "node ./node_modules/@changesets/cli/bin.js version",
    "cs:release": "vite build && node ./node_modules/@changesets/cli/bin.js publish",
    "lint": "biome check --write .",
    "lint:branch": "bunx branch-name-lint .husky/branch-name-lint.json",
    "format": "biome format --write . && bun run format:markdown",
    "format:markdown": "prettier --write \"**/*.md\" && prettier --parser markdown --write --no-error-on-unmatched-pattern \"**/llms.txt\"",
    "format:markdown:check": "prettier --check \"**/*.md\" && prettier --parser markdown --check --no-error-on-unmatched-pattern \"**/llms.txt\"",
    "prepare": "husky && svelte-kit sync",
    "test": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && vitest --config=vitest.config.ts \"$@\"' --",
    "locations:seed:lifecycle": "python3 scripts/locations/seed-lifecycle.py",
    "test:locations": "bun test src/lib/locations/location.test.ts",
    "test:scripts": "bun test ./scripts",
    "test:run": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && bun run test:locations && bun run test:scripts && vitest run --config=vitest.config.ts \"$@\"' --",
    "test:run:verbose": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && bun run test:locations && bun run test:scripts && vitest run --config=vitest.config.ts --reporter=verbose \"$@\"' --",
    "test:run:metrics": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && bun run test:locations && bun run test:scripts && vitest run --config=vitest.config.ts --reporter=default \"$@\"' --",
    "test:watch": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && vitest watch --config=vitest.config.ts \"$@\"' --",
    "test:ui": "bash scripts/dev-check.sh bash -c 'bun run i18n:build && vitest --config=vitest.config.ts --ui \"$@\"' --",
    "verify:sveltekit-patch": "bun run scripts/verify-sveltekit-patch.ts",
    "i18n:translate": "bunx @inlang/cli machine translate --project project.inlang",
    "i18n:build": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
    "db:chart": "bash scripts/dev/export-schema-to-clipboard.sh",
    "db:generate:dbml": "bun run scripts/generate-dbml.ts",
    "commit": "git-cz",
    "breadline:db:backup": "bun run scripts/breadline/backup.ts",
    "breadline:db:import": "bun --env-file=.dev.vars run scripts/breadline/import.ts",
    "breadline:users:plan": "bun --env-file=.dev.vars run scripts/breadline/users.ts",
    "breadline:users:test": "bun run scripts/breadline/rehearse-users.ts",
    "breadline:users:sync": "bun run scripts/breadline/sync-users.ts",
    "breadline:users:apply-production": "bun run scripts/breadline/apply-users-production.ts",
    "breadline:local:prepare": "bun run scripts/breadline/prepare-local.ts",
    "check:location-refresh": "tsc -p workers/location-refresh/tsconfig.json",
    "deploy:location-refresh:prod": "bun wrangler deploy -c workers/location-refresh/wrangler.jsonc --env production",
    "deploy:location-refresh:preview": "bun wrangler deploy -c workers/location-refresh/wrangler.jsonc --env preview",
    "build:workers": "turbo run build --filter=./workers/*",
    "check:workers": "bash scripts/dev-check.sh bash -c 'turbo run check --filter=@hype/* \"$@\"' --",
    "test:workers": "bash scripts/dev-check.sh bash -c 'bun test scripts/messaging/dev-worker.test.ts && turbo run test --filter=@hype/* \"$@\"' --",
    "dev:messaging": "turbo run dev --filter=./workers/*",
    "build:all": "bun run build:workers && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@iconify/json": "^2.2.553",
    "@inlang/paraglide-js": "^3.1.0",
    "@libsql/client": "^0.18.0",
    "@miniflare/d1": "^2.14.4",
    "@nerdfolio/drizzle-d1-helpers": "^0.1.5",
    "@playwright/test": "^1.64.1",
    "@protomaps/basemaps": "^5.7.2",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/upgrade": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.2",
    "@types/proj4": "^2.19.0",
    "@types/utif": "^3.0.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "baseline-browser-mapping": "^2.11.35",
    "branch-name-lint": "^3.0.1",
    "caniuse-lite": "^1.0.30001820",
    "commitizen": "^4.3.2",
    "dotenv-load": "^3.0.0",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "inquirer": "^14.2.5",
    "jsdom": "^30.1.3",
    "node-gyp": "^13.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "turbo": "2.5.8"
  },
  "type": "module",
  "trustedDependencies": [
    "@sveltejs/kit",
    "edgedriver",
    "esbuild",
    "geckodriver",
    "msw",
    "sharp",
    "svelte-preprocess",
    "workerd"
  ],
  "dependencies": {
    "@better-auth/core": "^1.7.17",
    "@better-auth/drizzle-adapter": "^1.7.17",
    "@better-auth/passkey": "^1.7.17",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@chenglou/pretext": "^1.0.0",
    "@emeraldpay/hashicon": "^0.5.2",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@internationalized/date": "3.12.4",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@saanseoi/address": "file:vendor/saanseoi-address-0.2.3.tgz",
    "@sillvva/utils": "^0.9.0",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/svelte-virtual": "^3.13.52",
    "@thisux/sveltednd": "0.8.0",
    "@turf/bbox": "^7.4.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.17",
    "bits-ui": "^2.20.4",
    "clsx": "^2.1.1",
    "coordinate-parser": "^1.0.7",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "esm-env": "1.2.2",
    "h3-js": "^4.5.0",
    "heic2any": "^0.0.4",
    "kysely": "^0.29.8",
    "libphonenumber-js": "1.13.15",
    "lottie-web": "^5.13.0",
    "maplibre-gl": "^6.16.0",
    "marked": "^18.1.3",
    "nanoid": "^6.0.2",
