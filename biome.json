{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/*.d.ts",
      "!**/*.svg",
      "!snippets",
      "!project.inlang/.meta.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConfusingVoidType": "off",
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": ["DEV", "HYPE_DEV_PERSONA", "HYPE_STATIC_BUILD"]
          }
        }
      },
      "correctness": {
        "noUnknownPseudoElement": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 88,
      "trailingCommas": "none",
      "bracketSpacing": true
    },
    "assist": {
      "enabled": false
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "static/indoor/kennedy-town/*_*.json",
        "static/indoor/hong-kong/*_*.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["docs/policies/*.md"],
      "markdown": {
        "formatter": {
          "proseWrap": "preserve"
        }
      }
    },
    {
      "includes": ["static/mocks/saanseoi/streets/names/data.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["static/mapStyles/*.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "workers/telegram/worker-configuration.d.ts",
        "workers/telegram-calls/worker-configuration.d.ts"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["**/tsconfig*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ],
  "markdown": {
    "formatter": {
      "enabled": true,
      "proseWrap": "always"
    },
    "parser": {
      "frontmatter": true
    }
  }
}
