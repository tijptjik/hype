{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hype-routing-native-benchmark",
  "main": "index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "NativeRouting",
      "image": "./Dockerfile",
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2000 },
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NATIVE", "class_name": "NativeRouting" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NativeRouting"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
