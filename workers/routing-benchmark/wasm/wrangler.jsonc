{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hype-routing-wasm-benchmark",
  "main": "index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "GRAPH_DATA", "bucket_name": "hype-routing-benchmark" }],
  "vars": { "MANIFEST_KEY": "datasets/hk-2026-10-01/manifest.json" },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
