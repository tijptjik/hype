{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hype-mtr-refresh",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "ROUTING_TOKEN"
    ]
  },
  "vars": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hype-db-local",
      "database_id": "6757bbf2-ac2c-4323-b73a-0a48f0c41d62",
      "migrations_dir": "../../migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "hype-mtr-refresh-preview",
      "secrets": {
        "required": [
          "ROUTING_TOKEN"
        ]
      },
      "vars": {},
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hype-db-preview",
          "database_id": "f6bae0f9-c072-4ef0-9b75-efcc792d40fb",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ROUTING_SERVICE",
          "service": "ss-routing-preview"
        }
      ]
    },
    "production": {
      "name": "hype-mtr-refresh-production",
      "secrets": {
        "required": [
          "ROUTING_TOKEN"
        ]
      },
      "vars": {},
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hype-db-prod",
          "database_id": "7786af0e-3782-47f8-b70d-de645ba836ad",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ROUTING_SERVICE",
          "service": "ss-routing-prod"
        }
      ]
    }
  },
  "services": [
    {
      "binding": "ROUTING_SERVICE",
      "service": "ss-routing-preview",
      "remote": true
    }
  ]
}
